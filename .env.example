# Environment variables for pi-code scripts.
#
# Copy this file to .env, fill in real values, then load it before running:
#
#   cp .env.example .env
#   set -a; source .env; set +a
#
# .env is gitignored — never commit real credentials.

# --- Nextcloud (rpi/pi4/main/upload_files.py, rpi/pi4/nextcloud_client/) ---
NEXTCLOUD_USER=youruser
NEXTCLOUD_PASSWORD=yourpassword
NEXTCLOUD_PUBLIC_LINK=https://your-server/nextcloud/index.php/s/XXXXXXXX

# --- easywebdav (rpi/pi4/main/easywebdav.py) ---
WEBDAV_HOST=webdav.your-server.com
WEBDAV_USER=youruser
WEBDAV_PASSWORD=yourpassword

# --- webdavclient3 (webdav/run_webdav3.py) ---
WEBDAV_HOSTNAME=https://your-server/nextcloud/remote.php/dav/files/youruser/
WEBDAV_LOGIN=youruser
# WEBDAV_PASSWORD is shared with easywebdav above

# --- Recording/upload paths (optional; defaults shown) ---
# Used by rpi/pi4/recording/*.py and the upload scripts.
ROOT_PATH=/home/pi
RECORDINGS_PATH=recordings
UPLOADED_RECORDINGS_PATH=uploaded

# ffmpeg encoding mode for record.py (optional; default "copy")
ENCODING=copy
